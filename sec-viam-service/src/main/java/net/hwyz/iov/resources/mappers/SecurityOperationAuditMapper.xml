<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.hwyz.iov.cloud.sec.viam.service.infrastructure.persistence.mapper.SecurityOperationAuditMapper">

    <select id="selectByOperationId" resultType="net.hwyz.iov.cloud.sec.viam.service.infrastructure.persistence.po.SecurityOperationAuditPo">
        SELECT * FROM tb_viam_security_operation_audit
        WHERE operation_id = #{operationId} AND row_valid = 1
        LIMIT 1
    </select>

</mapper>
