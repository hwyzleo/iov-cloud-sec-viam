<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.hwyz.iov.cloud.sec.viam.service.infrastructure.persistence.mapper.ProvisioningBatchMapper">

    <select id="selectByRequestId" resultType="net.hwyz.iov.cloud.sec.viam.service.infrastructure.persistence.po.ProvisioningBatchPo">
        SELECT * FROM tb_viam_business_key_provisioning
        WHERE request_id = #{requestId} AND row_valid = 1
        LIMIT 1
    </select>

</mapper>
