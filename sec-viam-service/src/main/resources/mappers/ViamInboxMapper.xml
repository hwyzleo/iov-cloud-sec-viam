<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.hwyz.iov.cloud.sec.viam.service.infrastructure.persistence.mapper.ViamInboxMapper">

    <select id="selectByEventId" resultType="net.hwyz.iov.cloud.sec.viam.service.infrastructure.persistence.po.ViamInboxPo">
        SELECT * FROM tb_viam_inbox
        WHERE event_id = #{eventId} AND row_valid = 1
    </select>

</mapper>
