<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.hwyz.iov.cloud.sec.viam.service.infrastructure.persistence.mapper.ProvisioningItemMapper">

    <select id="selectItemsByProvisioningId" resultType="net.hwyz.iov.cloud.sec.viam.service.infrastructure.persistence.po.ProvisioningItemPo">
        SELECT * FROM tb_viam_business_key_provisioning_item
        WHERE provisioning_id = #{provisioningId} AND row_valid = 1
    </select>

</mapper>
